# ============================================
# KimsWeb .gitignore
# 기술스택: Java 21, Spring Boot 3.x, Gradle,
# React(Vite), TypeScript, PostgreSQL, Redis, ChromaDB
# ============================================

# ===== Java / Spring Boot / Gradle =====
# Compiled class files
*.class

# Log files
*.log
logs/
**/logs/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle build output
.gradle/
build/
target/
out/
bin/

# Gradle wrapper (선택사항 - 보통은 버전 관리에 포함)
# gradle/wrapper/gradle-wrapper.jar
# gradle/wrapper/gradle-wrapper.properties

# Spring Boot application configuration (민감 정보)
application-dev.properties
application-local.properties
application-*.properties
!application.properties
!application-example.properties

# Spring Boot Actuator
**/actuator/

# ===== Frontend (React + Vite + TypeScript) =====
# Node.js / npm / yarn
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Vite build output
dist/
dist-ssr/
*.local

# TypeScript compiled output (빌드 시 생성)
*.tsbuildinfo
**/*.tsbuildinfo

# 환경 변수 파일 (민감 정보)
.env
.env.*
!.env.example

# ===== IDE 및 개발 도구 =====
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Eclipse
.project
.classpath
.settings/
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
.svn/
.factorypath

# VS Code
.vscode/
*.code-workspace

# STS (Spring Tool Suite)
.sts4-cache/

# ===== OS 및 시스템 =====
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
*.pid

# ===== 프로젝트 특정 파일 =====
# 데이터베이스 (로컬)
*.db
*.sqlite
*.sqlite3
*.h2.db
*.mv.db
*.trace.db

# ChromaDB 데이터 (로컬)
chroma-data/
chromadb/
**/chroma/
**/chromadb/
*.chroma

# Redis 데이터
dump.rdb
appendonly.aof
*.rdb
*.aof

# 업로드된 문서 (로컬 저장소)
uploads/
**/uploads/
**/attachments/

# 임시 파일
tmp/
temp/
**/tmp/
**/temp/

# ===== Docker 관련 =====
# Docker Compose 환경 변수
.env.docker
.dockerignore

# ===== 백업 파일 =====
*.bak
*.backup
*.old
*.orig
*.rej

# ===== 테스트 및 커버리지 =====
# Jacoco
jacoco.exec
**/jacoco/
**/test-output/
**/coverage/

# Test reports
**/test-reports/
**/test-results/

# ===== 기타 =====
# Spring Boot DevTools
!.mvn/wrapper/maven-wrapper.jar

# API 문서 (빌드 시 생성)
**/api-docs/
**/swagger-ui/
**/openapi/

# 프로파일링
**/profiles/
*.hprof
*.heapdump